{
  "$defs": {
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {},
          "type": "array"
        },
        {
          "additionalProperties": true,
          "type": "object"
        }
      ]
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Traceable origin without credentials or large raw payloads.",
      "properties": {
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "producer": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Producer",
          "type": "string"
        },
        "source_hashes": {
          "additionalProperties": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Hashes",
          "type": "object"
        },
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "producer"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "catalog_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Catalog Hash",
      "type": "string"
    },
    "compiled_at": {
      "format": "date-time",
      "title": "Compiled At",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
        "type": "string"
      },
      "title": "Dataset Ids",
      "type": "array"
    },
    "file_hashes": {
      "additionalProperties": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "File Hashes",
      "type": "object"
    },
    "fts_schema_version": {
      "default": "1",
      "title": "Fts Schema Version",
      "type": "string"
    },
    "mapping_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Mapping Hash",
      "type": "string"
    },
    "object_id": {
      "pattern": "^[a-z][a-z0-9_-]{2,127}$",
      "title": "Object Id",
      "type": "string"
    },
    "package_version": {
      "title": "Package Version",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "registry_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Registry Hash",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "object_id",
    "created_at",
    "content_hash",
    "provenance",
    "package_version",
    "compiled_at",
    "dataset_ids",
    "file_hashes",
    "mapping_hash",
    "catalog_hash",
    "registry_hash"
  ],
  "title": "SemanticManifest",
  "type": "object"
}
