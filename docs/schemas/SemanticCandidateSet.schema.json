{
  "$defs": {
    "CandidateItem": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "item_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Item Id",
          "type": "string"
        },
        "item_type": {
          "enum": [
            "dataset",
            "metric",
            "measure",
            "field",
            "entity",
            "recipe",
            "method",
            "value"
          ],
          "title": "Item Type",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "item_type",
        "display_name",
        "summary",
        "score"
      ],
      "title": "CandidateItem",
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {},
          "type": "array"
        },
        {
          "additionalProperties": true,
          "type": "object"
        }
      ]
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Traceable origin without credentials or large raw payloads.",
      "properties": {
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "producer": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Producer",
          "type": "string"
        },
        "source_hashes": {
          "additionalProperties": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Hashes",
          "type": "object"
        },
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "producer"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CandidateItem"
      },
      "title": "Dataset Candidates",
      "type": "array"
    },
    "entity_candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CandidateItem"
      },
      "title": "Entity Candidates",
      "type": "array"
    },
    "field_candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CandidateItem"
      },
      "title": "Field Candidates",
      "type": "array"
    },
    "measure_candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CandidateItem"
      },
      "title": "Measure Candidates",
      "type": "array"
    },
    "method_candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CandidateItem"
      },
      "title": "Method Candidates",
      "type": "array"
    },
    "metric_candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CandidateItem"
      },
      "title": "Metric Candidates",
      "type": "array"
    },
    "object_id": {
      "pattern": "^[a-z][a-z0-9_-]{2,127}$",
      "title": "Object Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "query": {
      "title": "Query",
      "type": "string"
    },
    "recipe_candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CandidateItem"
      },
      "title": "Recipe Candidates",
      "type": "array"
    },
    "retrieval_version": {
      "title": "Retrieval Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "value_candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CandidateItem"
      },
      "title": "Value Candidates",
      "type": "array"
    }
  },
  "required": [
    "object_id",
    "created_at",
    "content_hash",
    "provenance",
    "query",
    "retrieval_version"
  ],
  "title": "SemanticCandidateSet",
  "type": "object"
}
