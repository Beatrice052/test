{
  "$defs": {
    "BucketPathItem": {
      "additionalProperties": false,
      "properties": {
        "aggregation_name": {
          "title": "Aggregation Name",
          "type": "string"
        },
        "bucket_kind": {
          "enum": [
            "terms",
            "composite",
            "date_histogram",
            "filters",
            "nested"
          ],
          "title": "Bucket Kind",
          "type": "string"
        },
        "dimension_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Dimension Id",
          "type": "string"
        },
        "key_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Field"
        }
      },
      "required": [
        "aggregation_name",
        "dimension_id",
        "bucket_kind"
      ],
      "title": "BucketPathItem",
      "type": "object"
    },
    "DatasetColumn": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregation"
        },
        "aggregation_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregation Name"
        },
        "aggregation_parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Aggregation Parameters",
          "type": "object"
        },
        "aggregation_result_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregation Result Path"
        },
        "aggregation_semantics": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregation Semantics"
        },
        "approximate": {
          "default": false,
          "title": "Approximate",
          "type": "boolean"
        },
        "business_domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Domain"
        },
        "data_type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "datetime",
            "metric"
          ],
          "title": "Data Type",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "field_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Id"
        },
        "measure_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measure Id"
        },
        "metric_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Id"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "nullable": {
          "default": false,
          "title": "Nullable",
          "type": "boolean"
        },
        "population_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population Scope"
        },
        "security_classification": {
          "default": "internal",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "title": "Security Classification",
          "type": "string"
        },
        "semantic_role": {
          "enum": [
            "dimension",
            "measure",
            "metric",
            "metadata"
          ],
          "title": "Semantic Role",
          "type": "string"
        },
        "semantic_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Type"
        },
        "source_field_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Field Id"
        },
        "source_grain": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Source Grain",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "data_type",
        "semantic_role"
      ],
      "title": "DatasetColumn",
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {},
          "type": "array"
        },
        {
          "additionalProperties": true,
          "type": "object"
        }
      ]
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Traceable origin without credentials or large raw payloads.",
      "properties": {
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "producer": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Producer",
          "type": "string"
        },
        "source_hashes": {
          "additionalProperties": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Hashes",
          "type": "object"
        },
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "producer"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bucket_path": {
      "items": {
        "$ref": "#/$defs/BucketPathItem"
      },
      "title": "Bucket Path",
      "type": "array"
    },
    "columns": {
      "items": {
        "$ref": "#/$defs/DatasetColumn"
      },
      "title": "Columns",
      "type": "array"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Dataset Id",
      "type": "string"
    },
    "dimensions": {
      "items": {
        "type": "string"
      },
      "title": "Dimensions",
      "type": "array"
    },
    "expected_complete_dimensions": {
      "items": {
        "type": "string"
      },
      "title": "Expected Complete Dimensions",
      "type": "array"
    },
    "grain": {
      "items": {
        "type": "string"
      },
      "title": "Grain",
      "type": "array"
    },
    "measures": {
      "default": [],
      "items": {
        "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
        "type": "string"
      },
      "title": "Measures",
      "type": "array"
    },
    "metrics": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
        "type": "string"
      },
      "title": "Metrics",
      "type": "array"
    },
    "object_id": {
      "pattern": "^[a-z][a-z0-9_-]{2,127}$",
      "title": "Object Id",
      "type": "string"
    },
    "primary_key": {
      "items": {
        "type": "string"
      },
      "title": "Primary Key",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "object_id",
    "created_at",
    "content_hash",
    "provenance",
    "dataset_id",
    "grain",
    "dimensions",
    "metrics",
    "primary_key",
    "expected_complete_dimensions",
    "columns",
    "bucket_path"
  ],
  "title": "DatasetContract",
  "type": "object"
}
