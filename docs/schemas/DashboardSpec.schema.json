{
  "$defs": {
    "ChartAnalysis": {
      "additionalProperties": false,
      "properties": {
        "caveats": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ChartFinding"
          },
          "minItems": 1,
          "title": "Findings",
          "type": "array"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "reading_guide": {
          "title": "Reading Guide",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "reading_guide",
        "findings"
      ],
      "title": "ChartAnalysis",
      "type": "object"
    },
    "ChartEncoding": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "series": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series"
        },
        "tooltip_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tooltip Fields",
          "type": "array"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "x": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        }
      },
      "title": "ChartEncoding",
      "type": "object"
    },
    "ChartFinding": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_row_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Row Ids",
          "type": "array"
        },
        "importance": {
          "enum": [
            "primary",
            "secondary",
            "supporting"
          ],
          "title": "Importance",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text",
        "importance",
        "evidence_row_ids"
      ],
      "title": "ChartFinding",
      "type": "object"
    },
    "DashboardBlock": {
      "additionalProperties": false,
      "properties": {
        "axis_format": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Axis Format",
          "type": "object"
        },
        "block_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Block Id",
          "type": "string"
        },
        "chart_analysis": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChartAnalysis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "chart_type": {
          "anyOf": [
            {
              "enum": [
                "bar",
                "line",
                "heatmap",
                "stacked_bar",
                "donut",
                "dot",
                "pareto",
                "table",
                "pivot"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chart Type"
        },
        "content": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Content",
          "type": "object"
        },
        "dataset_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Id"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "encoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChartEncoding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "insights": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Insights",
          "type": "array"
        },
        "kpis": {
          "default": [],
          "items": {
            "$ref": "#/$defs/KpiItem"
          },
          "title": "Kpis",
          "type": "array"
        },
        "legend": {
          "default": true,
          "title": "Legend",
          "type": "boolean"
        },
        "sort": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Sort",
          "type": "array"
        },
        "stack": {
          "default": false,
          "title": "Stack",
          "type": "boolean"
        },
        "suggestions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Suggestions",
          "type": "array"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "type": {
          "enum": [
            "answer_summary",
            "context_summary",
            "kpi_group",
            "chart",
            "data_table",
            "pivot_table",
            "insight_list",
            "warning",
            "empty_state",
            "clarification",
            "follow_up_suggestions"
          ],
          "title": "Type",
          "type": "string"
        },
        "visualization_intent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visualization Intent"
        }
      },
      "required": [
        "block_id",
        "type"
      ],
      "title": "DashboardBlock",
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {},
          "type": "array"
        },
        {
          "additionalProperties": true,
          "type": "object"
        }
      ]
    },
    "KpiItem": {
      "additionalProperties": false,
      "properties": {
        "definition": {
          "title": "Definition",
          "type": "string"
        },
        "evidence_row_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Row Ids",
          "type": "array"
        },
        "formatted_value": {
          "title": "Formatted Value",
          "type": "string"
        },
        "kpi_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Kpi Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "quality": {
          "default": "valid",
          "enum": [
            "valid",
            "insufficient_sample",
            "not_applicable"
          ],
          "title": "Quality",
          "type": "string"
        },
        "semantic_level": {
          "enum": [
            "certified",
            "governed",
            "operational",
            "exploratory"
          ],
          "title": "Semantic Level",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "$ref": "#/$defs/JsonScalar"
        }
      },
      "required": [
        "kpi_id",
        "label",
        "value",
        "formatted_value",
        "semantic_level",
        "definition"
      ],
      "title": "KpiItem",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Traceable origin without credentials or large raw payloads.",
      "properties": {
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "producer": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Producer",
          "type": "string"
        },
        "source_hashes": {
          "additionalProperties": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Hashes",
          "type": "object"
        },
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "producer"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blocks": {
      "items": {
        "$ref": "#/$defs/DashboardBlock"
      },
      "title": "Blocks",
      "type": "array"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "layout": {
      "const": "auto_grid",
      "default": "auto_grid",
      "title": "Layout",
      "type": "string"
    },
    "object_id": {
      "pattern": "^[a-z][a-z0-9_-]{2,127}$",
      "title": "Object Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "object_id",
    "created_at",
    "content_hash",
    "provenance",
    "title",
    "blocks"
  ],
  "title": "DashboardSpec",
  "type": "object"
}
