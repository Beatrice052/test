{
  "$defs": {
    "ImportIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "field_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Path"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR",
            "FATAL"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Row"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "ImportIssue",
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {},
          "type": "array"
        },
        {
          "additionalProperties": true,
          "type": "object"
        }
      ]
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Traceable origin without credentials or large raw payloads.",
      "properties": {
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "producer": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Producer",
          "type": "string"
        },
        "source_hashes": {
          "additionalProperties": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Hashes",
          "type": "object"
        },
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "producer"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ambiguous_rows": {
      "default": [],
      "items": {
        "type": "integer"
      },
      "title": "Ambiguous Rows",
      "type": "array"
    },
    "blocked_fields": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Blocked Fields",
      "type": "array"
    },
    "catalog_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Catalog Hash",
      "type": "string"
    },
    "catalog_only_fields": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Catalog Only Fields",
      "type": "array"
    },
    "catalog_row_count": {
      "minimum": 0,
      "title": "Catalog Row Count",
      "type": "integer"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "duplicate_field_paths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Duplicate Field Paths",
      "type": "array"
    },
    "invalid_metric_bindings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Invalid Metric Bindings",
      "type": "array"
    },
    "issues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ImportIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "mapping_field_count": {
      "minimum": 0,
      "title": "Mapping Field Count",
      "type": "integer"
    },
    "mapping_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Mapping Hash",
      "type": "string"
    },
    "mapping_only_fields": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Mapping Only Fields",
      "type": "array"
    },
    "matched_count": {
      "minimum": 0,
      "title": "Matched Count",
      "type": "integer"
    },
    "object_id": {
      "pattern": "^[a-z][a-z0-9_-]{2,127}$",
      "title": "Object Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "sanitized_descriptions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Sanitized Descriptions",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "PASSED",
        "PASSED_WITH_WARNINGS",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    },
    "type_conflicts": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Type Conflicts",
      "type": "array"
    }
  },
  "required": [
    "object_id",
    "created_at",
    "content_hash",
    "provenance",
    "status",
    "mapping_field_count",
    "catalog_row_count",
    "matched_count",
    "mapping_hash",
    "catalog_hash"
  ],
  "title": "ImportReport",
  "type": "object"
}
