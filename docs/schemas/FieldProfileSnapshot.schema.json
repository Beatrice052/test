{
  "$defs": {
    "FieldProfile": {
      "additionalProperties": false,
      "description": "Bounded aggregate profile; it never contains raw OpenSearch documents.",
      "properties": {
        "cardinality_approximate": {
          "default": true,
          "title": "Cardinality Approximate",
          "type": "boolean"
        },
        "cardinality_estimate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cardinality Estimate"
        },
        "document_count": {
          "minimum": 0,
          "title": "Document Count",
          "type": "integer"
        },
        "mapping_type": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Mapping Type",
          "type": "string"
        },
        "maximum": {
          "$ref": "#/$defs/JsonScalar",
          "default": null
        },
        "minimum": {
          "$ref": "#/$defs/JsonScalar",
          "default": null
        },
        "missing_count": {
          "minimum": 0,
          "title": "Missing Count",
          "type": "integer"
        },
        "non_null_count": {
          "minimum": 0,
          "title": "Non Null Count",
          "type": "integer"
        },
        "physical_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Physical Path",
          "type": "string"
        },
        "sample_values": {
          "default": [],
          "items": {
            "$ref": "#/$defs/JsonScalar"
          },
          "maxItems": 10,
          "title": "Sample Values",
          "type": "array"
        },
        "source_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "physical_path",
        "mapping_type",
        "document_count",
        "non_null_count",
        "missing_count"
      ],
      "title": "FieldProfile",
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {},
          "type": "array"
        },
        {
          "additionalProperties": true,
          "type": "object"
        }
      ]
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Traceable origin without credentials or large raw payloads.",
      "properties": {
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "producer": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Producer",
          "type": "string"
        },
        "source_hashes": {
          "additionalProperties": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Hashes",
          "type": "object"
        },
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "producer"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Dataset Id",
      "type": "string"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FieldProfile"
      },
      "title": "Fields",
      "type": "array"
    },
    "indices": {
      "items": {
        "type": "string"
      },
      "title": "Indices",
      "type": "array"
    },
    "mapping_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Mapping Content Hash",
      "type": "string"
    },
    "object_id": {
      "pattern": "^[a-z][a-z0-9_-]{2,127}$",
      "title": "Object Id",
      "type": "string"
    },
    "profile_query_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Profile Query Hash",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "object_id",
    "created_at",
    "content_hash",
    "provenance",
    "dataset_id",
    "captured_at",
    "indices",
    "mapping_content_hash",
    "fields",
    "profile_query_hash"
  ],
  "title": "FieldProfileSnapshot",
  "type": "object"
}
