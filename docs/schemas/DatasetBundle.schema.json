{
  "$defs": {
    "DataQARecord": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Id"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "evidence_row_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Row Ids",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "metric_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Id"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "rule_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Rule Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR",
            "FATAL"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "severity",
        "passed",
        "message"
      ],
      "title": "DataQARecord",
      "type": "object"
    },
    "DatasetColumn": {
      "additionalProperties": false,
      "properties": {
        "business_domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Domain"
        },
        "data_type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "datetime",
            "metric"
          ],
          "title": "Data Type",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "field_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Id"
        },
        "metric_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Id"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "nullable": {
          "default": false,
          "title": "Nullable",
          "type": "boolean"
        },
        "security_classification": {
          "default": "internal",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "title": "Security Classification",
          "type": "string"
        },
        "semantic_role": {
          "enum": [
            "dimension",
            "measure",
            "metric",
            "metadata"
          ],
          "title": "Semantic Role",
          "type": "string"
        },
        "semantic_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Type"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "data_type",
        "semantic_role"
      ],
      "title": "DatasetColumn",
      "type": "object"
    },
    "DatasetCompleteness": {
      "enum": [
        "COMPLETE",
        "TOP_N_WITH_OTHERS",
        "TRUNCATED",
        "PARTIAL",
        "UNKNOWN"
      ],
      "title": "DatasetCompleteness",
      "type": "string"
    },
    "DatasetRow": {
      "additionalProperties": false,
      "properties": {
        "row_id": {
          "pattern": "^row_[0-9a-f]{16}$",
          "title": "Row Id",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "row_id",
        "values"
      ],
      "title": "DatasetRow",
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {},
          "type": "array"
        },
        {
          "additionalProperties": true,
          "type": "object"
        }
      ]
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Traceable origin without credentials or large raw payloads.",
      "properties": {
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "producer": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Producer",
          "type": "string"
        },
        "source_hashes": {
          "additionalProperties": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Hashes",
          "type": "object"
        },
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "producer"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ReconciliationRecord": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actual"
        },
        "dataset_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Dataset Ids",
          "type": "array"
        },
        "expected": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reconciliation_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Reconciliation Id",
          "type": "string"
        },
        "tolerance": {
          "default": 0,
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        }
      },
      "required": [
        "reconciliation_id",
        "passed",
        "expected",
        "actual",
        "message",
        "dataset_ids"
      ],
      "title": "ReconciliationRecord",
      "type": "object"
    },
    "TabularDataset": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/DatasetColumn"
          },
          "title": "Columns",
          "type": "array"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "completeness": {
          "$ref": "#/$defs/DatasetCompleteness"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "contract_id": {
          "title": "Contract Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "derivation_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derivation Id"
        },
        "grain": {
          "items": {
            "type": "string"
          },
          "title": "Grain",
          "type": "array"
        },
        "kind": {
          "enum": [
            "base",
            "derived"
          ],
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "pattern": "^[a-z][a-z0-9_-]{2,127}$",
          "title": "Object Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/DatasetRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^[1-9][0-9]*\\.[0-9]+$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_dataset_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Source Dataset Ids",
          "type": "array"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "object_id",
        "created_at",
        "content_hash",
        "provenance",
        "dataset_id",
        "contract_id",
        "kind",
        "grain",
        "columns",
        "rows",
        "completeness",
        "complete",
        "truncated"
      ],
      "title": "TabularDataset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_qa": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DataQARecord"
      },
      "title": "Data Qa",
      "type": "array"
    },
    "datasets": {
      "items": {
        "$ref": "#/$defs/TabularDataset"
      },
      "title": "Datasets",
      "type": "array"
    },
    "object_id": {
      "pattern": "^[a-z][a-z0-9_-]{2,127}$",
      "title": "Object Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "reconciliation": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReconciliationRecord"
      },
      "title": "Reconciliation",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "object_id",
    "created_at",
    "content_hash",
    "provenance",
    "datasets",
    "complete"
  ],
  "title": "DatasetBundle",
  "type": "object"
}
