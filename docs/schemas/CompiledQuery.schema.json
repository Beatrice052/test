{
  "$defs": {
    "BucketPathItem": {
      "additionalProperties": false,
      "properties": {
        "aggregation_name": {
          "title": "Aggregation Name",
          "type": "string"
        },
        "bucket_kind": {
          "enum": [
            "terms",
            "composite",
            "date_histogram",
            "filters",
            "nested"
          ],
          "title": "Bucket Kind",
          "type": "string"
        },
        "dimension_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Dimension Id",
          "type": "string"
        },
        "key_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Field"
        }
      },
      "required": [
        "aggregation_name",
        "dimension_id",
        "bucket_kind"
      ],
      "title": "BucketPathItem",
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {},
          "type": "array"
        },
        {
          "additionalProperties": true,
          "type": "object"
        }
      ]
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Traceable origin without credentials or large raw payloads.",
      "properties": {
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "producer": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Producer",
          "type": "string"
        },
        "source_hashes": {
          "additionalProperties": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Hashes",
          "type": "object"
        },
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "producer"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "QuerySemantics": {
      "additionalProperties": false,
      "properties": {
        "bucket_path": {
          "items": {
            "$ref": "#/$defs/BucketPathItem"
          },
          "title": "Bucket Path",
          "type": "array"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "field_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Field Ids",
          "type": "array"
        },
        "filter_fingerprint": {
          "title": "Filter Fingerprint",
          "type": "string"
        },
        "grain": {
          "items": {
            "type": "string"
          },
          "title": "Grain",
          "type": "array"
        },
        "metric_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Metric Ids",
          "type": "array"
        },
        "time_field_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Time Field Id",
          "type": "string"
        },
        "time_range": {
          "$ref": "#/$defs/TimeRange"
        }
      },
      "required": [
        "dataset_id",
        "time_range",
        "time_field_id",
        "field_ids",
        "metric_ids",
        "filter_fingerprint",
        "grain",
        "bucket_path"
      ],
      "title": "QuerySemantics",
      "type": "object"
    },
    "TimeRange": {
      "additionalProperties": false,
      "description": "Half-open business time range.",
      "properties": {
        "from_inclusive": {
          "format": "date-time",
          "title": "From Inclusive",
          "type": "string"
        },
        "timezone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "to_exclusive": {
          "format": "date-time",
          "title": "To Exclusive",
          "type": "string"
        }
      },
      "required": [
        "from_inclusive",
        "to_exclusive",
        "timezone"
      ],
      "title": "TimeRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "indices": {
      "items": {
        "type": "string"
      },
      "title": "Indices",
      "type": "array"
    },
    "object_id": {
      "pattern": "^[a-z][a-z0-9_-]{2,127}$",
      "title": "Object Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "query_dsl": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Query Dsl",
      "type": "object"
    },
    "query_fingerprint": {
      "title": "Query Fingerprint",
      "type": "string"
    },
    "query_plan_id": {
      "title": "Query Plan Id",
      "type": "string"
    },
    "result_contract_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Result Contract Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "semantics": {
      "$ref": "#/$defs/QuerySemantics"
    },
    "step_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Step Id",
      "type": "string"
    },
    "timeout_ms": {
      "title": "Timeout Ms",
      "type": "integer"
    }
  },
  "required": [
    "object_id",
    "created_at",
    "content_hash",
    "provenance",
    "query_plan_id",
    "step_id",
    "indices",
    "query_dsl",
    "semantics",
    "query_fingerprint",
    "timeout_ms",
    "result_contract_id"
  ],
  "title": "CompiledQuery",
  "type": "object"
}
