{
  "$defs": {
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {},
          "type": "array"
        },
        {
          "additionalProperties": true,
          "type": "object"
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Id"
    },
    "details": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Details",
      "type": "object"
    },
    "evidence_row_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Row Ids",
      "type": "array"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "metric_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metric Id"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "rule_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Rule Id",
      "type": "string"
    },
    "severity": {
      "enum": [
        "INFO",
        "WARNING",
        "ERROR",
        "FATAL"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "required": [
    "rule_id",
    "severity",
    "passed",
    "message"
  ],
  "title": "DataQARecord",
  "type": "object"
}
