{
  "$defs": {
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {},
          "type": "array"
        },
        {
          "additionalProperties": true,
          "type": "object"
        }
      ]
    },
    "MappingField": {
      "additionalProperties": false,
      "properties": {
        "aggregatable": {
          "default": false,
          "title": "Aggregatable",
          "type": "boolean"
        },
        "date_format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Format"
        },
        "is_multifield": {
          "default": false,
          "title": "Is Multifield",
          "type": "boolean"
        },
        "mapping_type": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Mapping Type",
          "type": "string"
        },
        "nested_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nested Path"
        },
        "observed_in_indices": {
          "items": {
            "type": "string"
          },
          "title": "Observed In Indices",
          "type": "array"
        },
        "parent_object_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Object Path"
        },
        "physical_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Physical Path",
          "type": "string"
        },
        "searchable": {
          "default": false,
          "title": "Searchable",
          "type": "boolean"
        },
        "sortable": {
          "default": false,
          "title": "Sortable",
          "type": "boolean"
        },
        "source_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "physical_path",
        "mapping_type",
        "observed_in_indices"
      ],
      "title": "MappingField",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Traceable origin without credentials or large raw payloads.",
      "properties": {
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "producer": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Producer",
          "type": "string"
        },
        "source_hashes": {
          "additionalProperties": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Hashes",
          "type": "object"
        },
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "producer"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Dataset Id",
      "type": "string"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/MappingField"
      },
      "title": "Fields",
      "type": "array"
    },
    "indices": {
      "items": {
        "type": "string"
      },
      "title": "Indices",
      "type": "array"
    },
    "object_id": {
      "pattern": "^[a-z][a-z0-9_-]{2,127}$",
      "title": "Object Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "raw_mapping_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Raw Mapping Hash",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "object_id",
    "created_at",
    "content_hash",
    "provenance",
    "dataset_id",
    "captured_at",
    "indices",
    "fields",
    "raw_mapping_hash"
  ],
  "title": "MappingSnapshot",
  "type": "object"
}
