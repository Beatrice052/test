{
  "$defs": {
    "AnalysisBudget": {
      "additionalProperties": false,
      "properties": {
        "max_blocks": {
          "default": 8,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Blocks",
          "type": "integer"
        },
        "max_buckets": {
          "default": 5000,
          "minimum": 1,
          "title": "Max Buckets",
          "type": "integer"
        },
        "max_queries": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Queries",
          "type": "integer"
        }
      },
      "title": "AnalysisBudget",
      "type": "object"
    },
    "AnalysisScope": {
      "additionalProperties": false,
      "properties": {
        "dataset_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Dataset Ids",
          "type": "array"
        },
        "filters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FilterIntent"
          },
          "title": "Filters",
          "type": "array"
        },
        "time_range": {
          "$ref": "#/$defs/TimeRange"
        }
      },
      "required": [
        "dataset_ids",
        "time_range"
      ],
      "title": "AnalysisScope",
      "type": "object"
    },
    "AnalyticalTask": {
      "additionalProperties": false,
      "properties": {
        "analysis_type": {
          "title": "Analysis Type",
          "type": "string"
        },
        "analytical_question": {
          "title": "Analytical Question",
          "type": "string"
        },
        "business_value": {
          "title": "Business Value",
          "type": "string"
        },
        "dimension_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Dimension Ids",
          "type": "array"
        },
        "drop_conditions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Drop Conditions",
          "type": "array"
        },
        "grain": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Grain",
          "type": "array"
        },
        "metric_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Metric Ids",
          "type": "array"
        },
        "priority": {
          "enum": [
            "required",
            "recommended",
            "optional"
          ],
          "title": "Priority",
          "type": "string"
        },
        "statistical_method_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Statistical Method Ids",
          "type": "array"
        },
        "task_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Task Id",
          "type": "string"
        },
        "visualization_intents": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Visualization Intents",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "analytical_question",
        "analysis_type",
        "priority",
        "business_value"
      ],
      "title": "AnalyticalTask",
      "type": "object"
    },
    "Clarification": {
      "additionalProperties": false,
      "properties": {
        "allowed_answers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Answers",
          "type": "array"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "question",
        "reason_code"
      ],
      "title": "Clarification",
      "type": "object"
    },
    "FilterIntent": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Field Id",
          "type": "string"
        },
        "operator": {
          "enum": [
            "eq",
            "in",
            "range",
            "exists",
            "not"
          ],
          "title": "Operator",
          "type": "string"
        },
        "values": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "field_id",
        "operator"
      ],
      "title": "FilterIntent",
      "type": "object"
    },
    "GovernedChartType": {
      "enum": [
        "bar",
        "line",
        "heatmap",
        "stacked_bar",
        "donut",
        "dot",
        "pareto",
        "table",
        "pivot"
      ],
      "type": "string"
    },
    "MetricDecision": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "decision": {
          "enum": [
            "required",
            "recommended",
            "optional",
            "rejected",
            "downgraded"
          ],
          "title": "Decision",
          "type": "string"
        },
        "metric_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Metric Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "rejection_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejection Code"
        },
        "required_capabilities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Capabilities",
          "type": "array"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "decision",
        "role",
        "reason",
        "confidence"
      ],
      "title": "MetricDecision",
      "type": "object"
    },
    "PresentationPreference": {
      "additionalProperties": false,
      "description": "A user presentation request interpreted by Agent A, not by the renderer.",
      "properties": {
        "requested_chart_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/GovernedChartType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unsupported_chart_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsupported Chart Label"
        },
        "user_specified": {
          "default": false,
          "title": "User Specified",
          "type": "boolean"
        }
      },
      "title": "PresentationPreference",
      "type": "object"
    },
    "TimeRange": {
      "additionalProperties": false,
      "description": "Half-open business time range.",
      "properties": {
        "from_inclusive": {
          "format": "date-time",
          "title": "From Inclusive",
          "type": "string"
        },
        "timezone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "to_exclusive": {
          "format": "date-time",
          "title": "To Exclusive",
          "type": "string"
        }
      },
      "required": [
        "from_inclusive",
        "to_exclusive",
        "timezone"
      ],
      "title": "TimeRange",
      "type": "object"
    },
    "TurnKind": {
      "enum": [
        "NEW_ANALYSIS",
        "CLARIFICATION",
        "FILTER_CHANGE",
        "TIME_CHANGE",
        "DIMENSION_CHANGE",
        "PRESENTATION_CHANGE",
        "EXPLANATION",
        "NEW_TOPIC"
      ],
      "title": "TurnKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_goal": {
      "title": "Analysis Goal",
      "type": "string"
    },
    "assumptions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/AnalysisBudget"
    },
    "clarification": {
      "anyOf": [
        {
          "$ref": "#/$defs/Clarification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "metric_decisions": {
      "items": {
        "$ref": "#/$defs/MetricDecision"
      },
      "title": "Metric Decisions",
      "type": "array"
    },
    "presentation_preference": {
      "$ref": "#/$defs/PresentationPreference"
    },
    "question_archetype": {
      "title": "Question Archetype",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/AnalysisScope"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/AnalyticalTask"
      },
      "title": "Tasks",
      "type": "array"
    },
    "turn_relation": {
      "$ref": "#/$defs/TurnKind"
    }
  },
  "required": [
    "analysis_goal",
    "question_archetype",
    "turn_relation",
    "scope",
    "metric_decisions",
    "tasks"
  ],
  "title": "AnalysisPlanDraft",
  "type": "object"
}
