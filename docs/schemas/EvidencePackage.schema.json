{
  "$defs": {
    "AdvancedEvidence": {
      "additionalProperties": false,
      "properties": {
        "compiled_queries": {
          "default": [],
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Compiled Queries",
          "type": "array"
        },
        "execution_summaries": {
          "default": [],
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Execution Summaries",
          "type": "array"
        },
        "query_plan": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Query Plan",
          "type": "object"
        },
        "result_contracts": {
          "default": [],
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Result Contracts",
          "type": "array"
        }
      },
      "required": [
        "query_plan"
      ],
      "title": "AdvancedEvidence",
      "type": "object"
    },
    "BusinessEvidence": {
      "additionalProperties": false,
      "properties": {
        "data_tables": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Data Tables",
          "type": "array"
        },
        "downloads": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Downloads",
          "type": "array"
        },
        "metric_definitions": {
          "default": [],
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Metric Definitions",
          "type": "array"
        },
        "quality": {
          "default": [],
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Quality",
          "type": "array"
        },
        "reconciliations": {
          "default": [],
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Reconciliations",
          "type": "array"
        },
        "scope": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Scope",
          "type": "object"
        }
      },
      "required": [
        "scope"
      ],
      "title": "BusinessEvidence",
      "type": "object"
    },
    "EvidenceRedaction": {
      "additionalProperties": false,
      "properties": {
        "masked_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Masked Fields",
          "type": "array"
        },
        "policy_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Id"
        },
        "removed_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Removed Fields",
          "type": "array"
        }
      },
      "title": "EvidenceRedaction",
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {},
          "type": "array"
        },
        {
          "additionalProperties": true,
          "type": "object"
        }
      ]
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Traceable origin without credentials or large raw payloads.",
      "properties": {
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "producer": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Producer",
          "type": "string"
        },
        "source_hashes": {
          "additionalProperties": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Hashes",
          "type": "object"
        },
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "producer"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "advanced": {
      "$ref": "#/$defs/AdvancedEvidence"
    },
    "business": {
      "$ref": "#/$defs/BusinessEvidence"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "debug_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Debug Ref"
    },
    "object_id": {
      "pattern": "^[a-z][a-z0-9_-]{2,127}$",
      "title": "Object Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "redaction": {
      "$ref": "#/$defs/EvidenceRedaction"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "object_id",
    "created_at",
    "content_hash",
    "provenance",
    "business",
    "advanced"
  ],
  "title": "EvidencePackage",
  "type": "object"
}
