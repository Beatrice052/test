CHATBI_APP_NAME=OpenSearch ChatBI POC
CHATBI_APP_ENV=development
CHATBI_DATA_SOURCE_MODE=mock
CHATBI_INTENT_BACKEND=mock
CHATBI_INDEX_PATTERN=tbl_os_sub_message_{yyyy}_{mm}
CHATBI_BUSINESS_TIMEZONE=Asia/Hong_Kong
CHATBI_DEFAULT_TIME_FROM=2026-07-01T00:00:00+08:00
CHATBI_DEFAULT_TIME_TO=2026-08-01T00:00:00+08:00
CHATBI_SEMANTIC_MODEL_VERSION=mock-semantic.v1
CHATBI_LLM_TIMEOUT_SECONDS=30
CHATBI_SESSION_TTL_SECONDS=1800
CHATBI_SESSION_CAPACITY=200
CHATBI_SESSION_MAX_MESSAGES=30
CHATBI_MAX_MESSAGE_CHARS=2000
